# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Comma-separated browser origins (required in production for CORS)
# Example: http://192.168.11.20:3000,https://library.example.com
CORS_ORIGINS=

# Set true only when served behind HTTPS (nginx TLS or USE_TLS=true)
USE_HTTPS=false
USE_TLS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=library
DB_USER=cyber_admin
DB_PASSWORD=change-me-strong-db-password

# 64+ random hex chars — openssl rand -hex 64
JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=1d

VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_ADMIN_LOGIN_PATH=/internal/auth/your-secret-path/login

OPENAI_API_KEY=

# Optional: override demo admin password when running `npm run seed` (never use defaults in production)
# SEED_ADMIN_PASSWORD=

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
