.env
.env.local
.env.*.local
config/secrets.env

# Dependencies & build
node_modules/
dist/
*.tsbuildinfo

# Uploads & large media (sync separately — not via git)
public/uploads/

# Logs & runtime
logs/
*.log
npm-debug.log*
.pm2/
pids/

