{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Library Management System — API + Admin UI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "certs:generate": "node scripts/generate-self-signed-certs.js",
    "build": "npm run client:build",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "import:pdfs": "node scripts/import-new-pdf-ebooks.js",
    "thumbs:pregenerate": "node scripts/pregenerate-cover-thumbs.js",
    "client:dev": "vite",
    "client:build": "tsc --noEmit && vite build",
    "client:preview": "vite preview"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "keywords": [
    "library",
    "express",
    "sequelize",
    "mysql",
    "react"
  ],
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "framer-motion": "^11.15.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jsdom": "^19.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^8.0.5",
    "openai": "^6.37.0",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.1",
    "sequelize": "^6.37.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
