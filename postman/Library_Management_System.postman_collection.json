{
  "info": {
    "_postman_id": "a1b2c3d4-library-mgmt-api",
    "name": "Library Management System API",
    "description": "Import into Postman. Set collection variables `adminName` and `adminPassword` locally (do not commit real credentials). Run **Admin login** first to get admin token.\n\nPrereqs: `npm run migrate`, optional `npm run seed`, `npm start`. Base URL from `.env` PORT (default 3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminName", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "demoUserName", "value": "" },
    { "key": "demoUserPassword", "value": "" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "registeredUserName", "value": "john_doe" },
    { "key": "registeredUserEmail", "value": "john@example.com" },
    { "key": "registeredUserPassword", "value": "SecurePass1!" },
    { "key": "categoryId", "value": "1" },
    { "key": "authorId", "value": "1" },
    { "key": "bookId", "value": "1" },
    { "key": "ebookId", "value": "1" },
    { "key": "departmentId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "adminId", "value": "1" },
    { "key": "rentId", "value": "1" },
    { "key": "dashboardTokenNote", "value": "Use admin token for /api/dashboard/*" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j.data && j.data.token) {",
                  "    pm.collectionVariables.set('adminToken', j.data.token);",
                  "    pm.collectionVariables.set('token', j.data.token);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminName\": \"{{adminName}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/admin/login"
          }
        },
        {
          "name": "POST User login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j.data && j.data.token) {",
                  "    pm.collectionVariables.set('userToken', j.data.token);",
                  "    pm.collectionVariables.set('token', j.data.token);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{demoUserName}}\",\n  \"password\": \"{{demoUserPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/user/login"
          }
        },
        {
          "name": "POST Register user (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"{{registeredUserName}}\",\n  \"email\": \"{{registeredUserEmail}}\",\n  \"password\": \"{{registeredUserPassword}}\",\n  \"date_of_birth\": \"2000-01-01\",\n  \"department_id\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "POST User login (pending/rejected check)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{registeredUserName}}\",\n  \"password\": \"{{registeredUserPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/user/login"
          }
        }
      ]
    },
